// Colors, sizes and type scale. Every color in the UI comes from here.

export enum Tone { idle, busy, good, warning, error }

export global Theme {
    out property <color> background: #0E1012;
    out property <color> sidebar: #121519;
    out property <color> surface: #161A1F;
    out property <color> surface-raised: #1B2026;
    out property <color> surface-hover: #212730;
    out property <color> field: #0F1215;
    out property <color> border: #262C33;
    out property <color> border-strong: #343C46;
    out property <color> text: #ECEEF1;
    out property <color> text-muted: #AEB5BE;
    out property <color> text-faint: #8C949E;
    out property <color> accent: #5AA9F0;
    out property <color> accent-hover: #74B7F3;
    out property <color> accent-pressed: #4A93D6;
    out property <color> accent-soft: #5AA9F0.with-alpha(14%);
    out property <color> on-accent: #07121D;
    out property <color> playback: #F0A04B;
    out property <color> good: #4CC38A;
    out property <color> warning: #F0B44B;
    out property <color> error: #F06A6A;
    out property <color> focus: #5AA9F0;

    out property <length> radius: 12px;
    out property <length> radius-small: 8px;
    out property <length> page-padding: 28px;

    out property <length> font-display: 24px;
    out property <length> font-title: 18px;
    out property <length> font-heading: 14px;
    out property <length> font-body: 13px;
    out property <length> font-small: 12px;

    public pure function tone-color(tone: Tone) -> color {
        if tone == Tone.good {
            return self.good;
        }
        if tone == Tone.warning {
            return self.warning;
        }
        if tone == Tone.error {
            return self.error;
        }
        if tone == Tone.busy {
            return self.accent;
        }
        return self.text-faint;
    }
}
